# TTMPV: High-performance native media engine and headless playback core.

load("@rules_swift//swift:swift.bzl", "swift_interop_hint", "swift_library", "swift_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "CTTMpvBridge",
    srcs = ["Sources/CTTMpvBridge/CTTMpvBridge.c"],
    hdrs = glob(["Sources/CTTMpvBridge/include/**/*.h"]),
    aspect_hints = [":cttmpvbridge_swift_interop"],
    defines = ["GL_SILENCE_DEPRECATION"],
    includes = ["Sources/CTTMpvBridge/include"],
    tags = ["swift_module=CTTMpvBridge"],
    deps = ["//third_party/mpv:mpv"],
)

swift_interop_hint(
    name = "cttmpvbridge_swift_interop",
    module_map = "Sources/CTTMpvBridge/include/module.modulemap",
    module_name = "CTTMpvBridge",
)

swift_library(
    name = "TTMPVKit",
    srcs = glob(["Sources/TTMPVKit/**/*.swift"]),
    copts = [
        "-enable-testing",
    ],
    module_name = "TTMPVKit",
    visibility = ["//visibility:public"],
    deps = [
        ":CTTMpvBridge",
    ],
)

swift_test(
    name = "TTMPVKitTests",
    srcs = glob(["Tests/TTMPVKitTests/**/*.swift"]),
    module_name = "TTMPVKitTests",
    visibility = ["//visibility:public"],
    deps = [
        ":TTMPVKit",
    ],
)
